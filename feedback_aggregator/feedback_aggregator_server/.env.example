# Generate real local values with: python3 scripts/create_local_env.py
# Load into the terminal that runs Serverpod: set -a; . ./.env; set +a
SERVERPOD_PASSWORD_database='<generate-a-local-database-password>'
SERVERPOD_PASSWORD_redis='<generate-a-local-redis-password>'
SERVERPOD_PASSWORD_serviceSecret='<generate-at-least-20-random-characters>'
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper='<generate-a-random-secret>'
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey='<generate-at-least-64-random-bytes>'
SERVERPOD_PASSWORD_emailSecretHashPepper='<generate-a-different-random-secret>'

# Separate credentials for optional Docker test services.
POSTGRES_TEST_PASSWORD='<generate-a-different-test-database-password>'
REDIS_TEST_PASSWORD='<generate-a-different-test-redis-password>'

# Optional: password-reset and invitation emails.
# Without a verified domain, Resend only delivers to its account owner's inbox.
# SERVERPOD_PASSWORD_resendApiKey='<resend-api-key>'
# SERVERPOD_PASSWORD_resendFromEmail='Feedback Aggregator <onboarding@resend.dev>'

# Optional: complete downloaded Google OAuth web-client JSON, on one line.
# SERVERPOD_PASSWORD_googleClientSecret='{"web":{"client_id":"<client-id>.apps.googleusercontent.com","client_secret":"<client-secret>","redirect_uris":["http://localhost:8082/auth/callback"]}}'

# Public ID, passed to Flutter with --dart-define=GOOGLE_CLIENT_ID="$GOOGLE_CLIENT_ID".
# GOOGLE_CLIENT_ID='<client-id>.apps.googleusercontent.com'
